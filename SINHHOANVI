#include <bits/stdc++.h>

using namespace std;

int n, a[15], vs[15];
// mang vs[15] la mang danh dau

void quaylui(int i){
	for (int j=1; j<=n; ++j){
		if(!vs[j]){
			a[i]=j;
			vs[j]=1;
			if (i==n){
				for (int x=1; x<=n; ++x){
					cout << a[x];
				}
				cout << " ";
			} else {
				quaylui(i+1);
			}
			vs[j]=0;
		}
	}
}

int main(){
	int t;
	cin >> t;
	while (t--){
		cin >> n;
		for (int i=1; i<=n; ++i){
			vs[i]=0;
		}
		quaylui(1);
		cout << "\n";
	}
	return 0;
}

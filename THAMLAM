#include <bits/stdc++.h>
using namespace std;
int a[10]={1000,500,200,100,50,20,10,5,2,1};
int n;
void input()
{
    cin>>n;    
}
void process()
{
    int countt=0;
    int i=0;
    while(n>0)
    {
        if(a[i]>n) 
        {
            i++;
            continue;
        }
        else 
        {
            countt=countt+(n/a[i]);
            n%=a[i];
            i++;
        }
    }
    cout<<countt<<"\n";
}
int main ()
{
    int t;
    cin>>t;
    while(t--)
    {
        input();
        process();
    }
}
